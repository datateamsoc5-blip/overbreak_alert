# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here

# SeaTalk Bot Credentials
SEATALK_APP_ID=your_seatalk_app_id_here
SEATALK_APP_SECRET=your_seatalk_app_secret_here
SEATALK_SIGNING_SECRET=your_signing_secret_here

# CC User IDs (comma-separated SeaTalk user IDs to mention)
# Ma'am/Sir's to be notified
CC_USER_IDS=1188946190,1495447455,1503543331,9394862575,1311274953,1361561520,1156011607,1394797084,1457707109,1474481317

# SeaTalk message pacing
SEATALK_MESSAGE_SEND_DELAY_SECONDS=1
SEATALK_MESSAGE_SEND_MAX_RETRIES=3
SEATALK_MESSAGE_SEND_RETRY_DELAY_SECONDS=3

# Environment
FLASK_ENV=development
